import sys
 
def solve():
    # Read everything into memory at once to save time
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    iterator = iter(input_data)
    num_test_cases = int(next(iterator))
    
    # Pre-allocate a single visited array to avoid garbage collection memory overhead
    # Using an integer token (test case ID) instead of True/False lets us "clear" it in O(1) time
    MAX_DIM = 252
    visited = [[0] * MAX_DIM for _ in range(MAX_DIM)]
    token = 0
    
    out = []
    
    for _ in range(num_test_cases):
        n = int(next(iterator))
        m = int(next(iterator))
        
        grid = [next(iterator) for _ in range(n)]
        token += 1  # Incrementing token effectively resets the visited array for this test case
        
        square_count = 0
        
        for r in range(n):
            for c in range(m):
                if grid[r][c] == '1' and visited[r][c] != token:
                    # Collect component coordinates
                    component = []
                    
                    # Pre-allocated style BFS using a flat structure
                    queue = [(r, c)]
                    visited[r][c] = token
                    
                    head = 0
                    while head < len(queue):
                        curr_r, curr_c = queue[head]
                        head += 1
                        component.append((curr_r, curr_c))
                        
                        # 8-directional check
                        for dr in (-1, 0, 1):
                            for dc in (-1, 0, 1):
                                if dr == 0 and dc == 0:
                                    continue
                                nr, nc = curr_r + dr, curr_c + dc
                                if 0 <= nr < n and 0 <= nc < m:
                                    if grid[nr][nc] == '1' and visited[nr][nc] != token:
                                        visited[nr][nc] = token
                                        queue.append((nr, nc))
                    
                    # Validate the component shape safely
                    if validate_square(component, grid, n, m):
                        square_count += 1
                        
        out.append(str(square_count))
        
    print('
'.join(out))
 
def validate_square(component, grid, n, m):
    # Find bounding dimensions
    min_r = min(p[0] for p in component)
    max_r = max(p[0] for p in component)
    min_c = min(p[1] for p in component)
    max_c = max(p[1] for p in component)
    
    # 1. Check for Type 1: Axis-aligned square
    height = max_r - min_r + 1
    width = max_c - min_c + 1
    
    if height == width and height >= 2:
        expected_size = 4 * height - 4
        if len(component) == expected_size:
            is_type1 = True
            for r in range(min_r, max_r + 1):
                if grid[r][min_c] != '1' or grid[r][max_c] != '1':
                    is_type1 = False
                    break
            if is_type1:
                for c in range(min_c, max_c + 1):
                    if grid[min_r][c] != '1' or grid[max_r][c] != '1':
                        is_type1 = False
                        break
            if is_type1:
                return True
                
    # 2. Check for Type 2: Diagonal/diamond square
    if (max_c - min_c) % 2 == 0:
        mid_c = (min_c + max_c) // 2
        if grid[min_r][mid_c] == '1':
            L = mid_c - min_c
            if L >= 1 and (max_r - min_r) == 2 * L:
                expected_size = 4 * L
                if len(component) == expected_size:
                    is_type2 = True
                    for i in range(L + 1):
                        if grid[min_r + i][mid_c - i] != '1': is_type2 = False
                        if grid[min_r + i][mid_c + i] != '1': is_type2 = False
                        if grid[max_r - i][mid_c - i] != '1': is_type2 = False
                        if grid[max_r - i][mid_c + i] != '1': is_type2 = False
                    if is_type2:
                        return True
                        
    return False
 
if __name__ == '__main__':
    solve()