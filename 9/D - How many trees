import sys
 
def solve():
    # Read n and h from standard input
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    n = int(input_data[0])
    h = int(input_data[1])
    
    # dp[i][j] stores the number of BSTs with i nodes and height <= j
    dp = [[0] * (n + 1) for _ in range(n + 1)]
    
    # Base case: An empty tree (0 nodes) always has a height <= j for any j >= 0
    for j in range(n + 1):
        dp[0][j] = 1
        
    # Fill the DP table
    for i in range(1, n + 1): # number of nodes
        for j in range(1, n + 1): # max allowed height
            for k in range(i): # number of nodes in the left subtree
                dp[i][j] += dp[k][j-1] * dp[i-1-k][j-1]
                
    # Total trees with n nodes is dp[n][n]
    # Trees with height less than h is dp[n][h-1]
    ans = dp[n][n] - dp[n][h-1]
    print(ans)
 
if __name__ == '__main__':
    solve()