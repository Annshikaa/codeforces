import sys
 
def solve():
    # Read all inputs from standard input
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    n_str = input_data[0]
    m_str = input_data[1]
    
    # Base case: if n is "0", the only valid minimum rearrangement is "0"
    if n_str == "0":
        correct_ans = "0"
    else:
        # Sort the digits in ascending order
        digits = sorted(list(n_str))
        
        # If the smallest digit is '0', swap it with the first non-zero digit
        if digits[0] == '0':
            for i in range(len(digits)):
                if digits[i] != '0':
                    # Swap the first '0' with the first non-zero digit found
                    digits[0], digits[i] = digits[i], digits[0]
                    break
                    
        correct_ans = "".join(digits)
    
    # Check if Bob's answer matches the correct answer string
    if m_str == correct_ans:
        print("OK")
    else:
        print("WRONG_ANSWER")
 
if __name__ == '__main__':
    solve()