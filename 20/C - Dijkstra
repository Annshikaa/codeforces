import sys
import heapq
 
def solve():
    # Fast I/O
    input_data = sys.stdin.read().split()
    if not input_data:
        return
 
    n = int(input_data[0])
    m = int(input_data[1])
 
    # Build adjacency list
    adj = [[] for _ in range(n + 1)]
    idx = 2
    for _ in range(m):
        u = int(input_data[idx])
        v = int(input_data[idx + 1])
        w = int(input_data[idx + 2])
        idx += 3
        
        if u != v:  # Ignore self-loops
            adj[u].append((v, w))
            adj[v].append((u, w))
 
    # Dijkstra's Algorithm
    dist = [float('inf')] * (n + 1)
    parent = [-1] * (n + 1)
    
    dist[1] = 0
    pq = [(0, 1)]  # (distance, node)
 
    while pq:
        d, u = heapq.heappop(pq)
 
        if d > dist[u]:
            continue
 
        if u == n:
            break
 
        for v, weight in adj[u]:
            if dist[u] + weight < dist[v]:
                dist[v] = dist[u] + weight
                parent[v] = u
                heapq.heappush(pq, (dist[v], v))
 
    # If vertex n is unreachable
    if dist[n] == float('inf'):
        print(-1)
        return
 
    # Backtrack to reconstruct the path
    path = []
    curr = n
    while curr != -1:
        path.append(curr)
        curr = parent[curr]
 
    path.reverse()
    print(*(path))
 
if __name__ == '__main__':
    solve()